flowchart LR
    %% Subgraphs por etapa lógica
    subgraph Captura["1. Captura & Validación Básica"]
        Start((Inicio)) --> RF01["RF-01: Registro Clave, UoM Base & Datos Básicos"]
        RF01 --> CheckID{"UT-03: ¿Clave válida?"}
        CheckID -- No --> RejectID["Rechazar: Formato inválido"] --> ErrEnd1((Fin Error))
        CheckID -- Sí --> CheckWeight{"UT-01: ¿Bruto >= Neto?"}
        CheckWeight -- No --> RejectWeight["Rechazar: Peso inválido"] --> ErrEnd2((Fin Error))
    end

    subgraph Logistica["2. Planificación & Logística"]
        CheckWeight -- Sí --> Sourcing{"Aprovisionamiento"}
        Sourcing -- "Externo (F)" --> RF02_Ext["RF-02/RN-06: Grupo Compras & Plazo"]
        Sourcing -- "Interno/Prod" --> RF02_Mfg["RF-02/RN-01: Tipo MRP & Lote"]
        RF02_Ext --> RF03["RF-03/RN-02: Extensión Centro & Almacén"]
        RF02_Mfg --> RF03
    end

    subgraph Finanzas["3. Comercial & Valoración"]
        RF03 --> Commercial{"¿Comercial?"}
        Commercial -- Sí --> RF04["RF-04/RN-03: Impuestos, Carga/Transporte"]
        Commercial -- No --> RF05["RF-05: Cat. Valoración & Control S/V"]
        RF04 --> RF05
        RF05 --> CheckPrice{"UT-05: ¿Precio > 0 en S?"}
        CheckPrice -- No --> RejectPrice["Rechazar: Precio inválido"] --> ErrEnd3((Fin Error))
        CheckPrice -- Sí --> CheckFK{"¿FKs en tablas maestras?"}
        CheckFK -- No --> Rollback["Rollback: Fallo Integridad"] --> ErrEnd4((Fin Error))
    end

    subgraph Operaciones["4. Persistencia & Ciclo Operativo"]
        CheckFK -- Sí --> Commit["Alta Atómica & Log de Auditoría"]
        Commit --> StatusCheck{"RN-04/RF-06: ¿Activo?"}
        StatusCheck -- Bloqueado --> BlockOps["Bloquear Compras/Ventas"] --> End1((Fin))
        StatusCheck -- Activo --> EnableOps["Habilitar Operaciones"]
        EnableOps --> StockMov["Entrada de Mercancías"]
        StockMov --> LockUoM["RN-05/FT-05: Bloqueo Inmutable UoM"]
        LockUoM --> End2((Fin))
    end
