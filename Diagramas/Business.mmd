flowchart LR
    %% Subgraph 1: Interacción del Usuario (Banda inferior)
    subgraph Usuario["Interacción del Usuario"]
        direction LR
        Start(["Inicio: Crear / Actualizar Artículo"]) --> IngresoDatos["RF-01: Ingresar Datos Críticos<br>(Clave, UoM Base, Categoría, Pesos)"]
        ConfigLogistica["RF-02 / RF-03 / RF-04:<br>Configurar MRP, Centros, Almacenes,<br>Impuestos y Valoración S/V"]
    end

    %% Subgraph 2: Capa de Lógica y Reglas de Negocio (Banda superior/central con decisiones diagonales)
    subgraph LogicaNegocio["Capa de Lógica y Reglas de Negocio"]
        direction TB
        ValFormato{"UT-03:<br>¿Formato de Clave Válido?<br>(Sin caracteres raros)"}
        ValPesos{"UT-01:<br>¿Precisión de Pesos OK?<br>(Peso Bruto >= Neto)"}
        ValIntegridad{"Integridad Referencial:<br>¿Centro, Almacén, Grupo Art.<br>y Cat. Valoración Existen?"}
        ValCampos{"RF-02 / RN-01 / RN-06:<br>¿Campos Mandatorios Completos?<br>(MRP/Lote o Compras)"}
        ValPrecios{"UT-05:<br>¿Precio Base > 0<br>en Control Estándar S?"}
        ValMutacion{"RN-05 / FT-05:<br>¿Intento de Modificar UoM Base<br>con Stock o Movimientos > 0?"}
    end

    %% Subgraph 3: Base de Datos ERP (Banda derecha de errores y persistencia)
    subgraph BaseDatos["Base de Datos ERP"]
        direction TB
        ErrFormato(["Error: Formato de Clave Inválido / Caracteres Especiales"]):::errStyle
        ErrPesos(["Error: Incoherencia Numérica (Peso Neto > Bruto)"]):::errStyle
        ErrFK(["Error: Entidad Referenciada Inexistente (Fallo FK)"]):::errStyle
        ErrCampos(["Error: Falta Información Obligatoria de Aprovisionamiento"]):::errStyle
        ErrPrecio(["Error: Precio Base Inválido o Nulo en Control S"]):::errStyle
        ErrMutacion(["Error: Bloqueo de Mutación Estructural por Existencias"]):::errStyle
        
        Persistir["Guardar Registro Maestro<br>(Commit Atómico)"]:::dbStyle
        AuditLog["Auditabilidad (Change Log):<br>Generar Log Inmutable de Auditoría"]:::dbStyle
        FinExito(["Fin: Artículo Activo<br>y Disponible en el Sistema"]):::successStyle
    end

    %% Conexiones e hilo conductor (recreando la cascada diagonal de la imagen)
    IngresoDatos --> ValFormato
    
    ValFormato -- No --> ErrFormato
    ValFormato -- Sí --> ValPesos
    
    ValPesos -- No --> ErrPesos
    ValPesos -- Sí --> ValIntegridad
    
    ValIntegridad -- No --> ErrFK
    ValIntegridad -- Sí --> ValCampos
    
    ValCampos -- No --> ErrCampos
    ValCampos -- Sí --> ConfigLogistica
    
    %% Retorno a la lógica tras la configuración del usuario
    ConfigLogistica --> ValPrecios
    
    ValPrecios -- No --> ErrPrecio
    ValPrecios -- Sí --> ValMutacion
    
    ValMutacion -- Sí --> ErrMutacion
    ValMutacion -- No --> Persistir
    
    %% Flujo de persistencia final
    Persistir --> AuditLog --> FinExito

    %% Estilos de Nodos inspirados en la imagen
    classDef errStyle fill:#FADBD8,stroke:#E74C3C,stroke-width:1px,color:#78281F;
    classDef dbStyle fill:#D4E6F1,stroke:#2980B9,stroke-width:1px,color:#1B4F72;
    classDef successStyle fill:#D5F5E3,stroke:#27AE60,stroke-width:1px,color:#145A32;
